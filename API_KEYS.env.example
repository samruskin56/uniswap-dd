# Template for API_KEYS.env — copy this file to API_KEYS.env and fill in your
# own keys. The real API_KEYS.env is git-ignored (see .gitignore: *.env) so your
# secrets are never committed; this .example file is tracked to document the format.
#
#   cp API_KEYS.env.example API_KEYS.env   # macOS / Linux
#   copy API_KEYS.env.example API_KEYS.env # Windows
#
# Keys are loaded from API_KEYS.env at runtime via python-dotenv. Use KEY=value
# with no quotes and no spaces around the '='.

DEFILLAMA_API_KEY=your_defillama_api_key_here
DUNE_API_KEY=your_dune_api_key_here
FRED_API_KEY=your_fred_api_key_here
MESSARI_API_KEY=your_messari_api_key_here
BLOCKWORKS_API_KEY=your_blockworks_api_key_here
COINGECKO_API_KEY=your_coingecko_api_key_here
TWITTER_API_KEY=your_twitter_bearer_token_here

# Optional: Solana RPC for the MetaDAO launch-account pull (src/data/metadao.py).
# Defaults to the public mainnet RPC when unset; a free Helius endpoint
# (https://www.helius.dev) is the fix if the public RPC times out.
SOLANA_RPC_URL=

# Yahoo Finance and MetaDAO's market API do not require an API key.
